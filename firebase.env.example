# Copy to firebase.env (git-ignored) and fill in. Both values are in the Firebase console:
# Project settings -> General -> Your apps -> Web app.
# The file is packed into exports, so restrict the key in the Google Cloud console
# (APIs & Services -> Credentials): Identity Toolkit API, Token Service API, Cloud Firestore API only.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-web-api-key
