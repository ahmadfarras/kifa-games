{
  "hosting": {
    "public": "build/web",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/runner.html", "destination": "/", "type": 301 },
      { "source": "/match.html", "destination": "/", "type": 301 },
      { "source": "/math.html", "destination": "/", "type": 301 },
      { "source": "/coloring.html", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(wasm|pck|js|png|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  }
}
