{
  "hosting": {
    "public": "build/web",
    "ignore": ["**/.*", "**/*.import"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/runner.html", "destination": "/", "type": 301 },
      { "source": "/match.html", "destination": "/", "type": 301 },
      { "source": "/math.html", "destination": "/", "type": 301 },
      { "source": "/coloring.html", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
        ]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(wasm|pck|js|png|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  }
}
